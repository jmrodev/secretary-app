e": "t", "is_member_call": false, "source_file": "/home/jmro/Documentos/proyectos/secretary-app/client/src/features/appointments/components/cards/AppointmentCard.jsx", "source_location": "L68"}, {"caller_nid": "cards_appointmentcard_appointmentcard", "callee": "replace", "is_member_call": true, "source_file": "/home/jmro/Documentos/proyectos/secretary-app/client/src/features/appointments/components/cards/AppointmentCard.jsx", "source_location": "L76"}, {"caller_nid": "cards_appointmentcard_appointmentcard", "callee": "String", "is_member_call": false, "source_file": "/home/jmro/Documentos/proyectos/secretary-app/client/src/features/appointments/components/cards/AppointmentCard.jsx", "source_location": "L76"}, {"caller_nid": "cards_appointmentcard_appointmentcard", "callee": "(() => {\n                    const isAttended = ['arrived', 'attended', 'completed'].includes(appt.status);\n                    const paid = Number(appt.paid_amount || 0);\n                    const pending = Number(appt.pending_amount || 0);\n                    const txTotal = paid + pending;\n                    const cost = Number(appt.cost || 0);\n                    const instBasePrice = Number(appt.institution_base_price || 0);\n                    const hasTransactions = txTotal > 0;\n                    const fallbackCost = cost > 0 ? cost : instBasePrice;\n                    const effectiveTotal = hasTransactions ? txTotal : fallbackCost;\n\n                    if (appt.bonified === 1 || appt.bonified === true || appt.bonified === 'true') {\n                        return (\n                            <div className=\"appointment-card__payment-info appointment-card__payment-info--bonified\">\n                                <span>{t('bonified') || 'Bonif.'}</span>\n                                <Icon name=\"verified\" className=\"appointment-card__payment-icon\" />\n                            </div>\n                        );\n                    }\n\n                    if (effectiveTotal === 0 && !isAttended) return null;\n\n                    let colorModifier = '';\n                    let amountToDisplay = effectiveTotal;\n                    let statusIcon = null;\n\n                    if (paid >= effectiveTotal && effectiveTotal > 0) {\n                        colorModifier = 'paid';\n                        amountToDisplay = paid;\n                        statusIcon = <Icon name=\"check_circle\" className=\"appointment-card__payment-icon\" />;\n                    } else if (!isAttended) {\n                        colorModifier = 'pending';\n                    } else if (pending > 0 || (!hasTransactions && cost > 0)) {\n                        colorModifier = 'debt';\n                        amountToDisplay = pending > 0 ? pending : cost;\n                        statusIcon = <Icon name=\"error\" className=\"appointment-card__payment-icon\" />;\n                    }\n\n                    if (amountToDisplay === 0) return null;\n\n                    return (\n                        <div className={`appointment-card__payment-info appointment-card__payment-info--${colorModifier}`}>\n                            <span>{formatCurrency(amountToDisplay)}</span>\n                            {statusIcon}\n                        </div>\n                    );\n                })", "is_member_call": false, "source_file": "/home/jmro/Documentos/proyectos/secretary-app/client/src/features/appointments/components/cards/AppointmentCard.jsx", "source_location": "L100"}, {"caller_nid": "cards_appointmentcard_appointmentcard", "callee": "t", "is_member_call": false, "source_file": "/home/jmro/Documentos/proyectos/secretary-app/client/src/features/appointments/components/cards/AppointmentCard.jsx", "source_location": "L149"}]}