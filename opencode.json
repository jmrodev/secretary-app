{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "explore": {
      "model": "opencode/laguna-s-2.1-free",
      "description": "Fast agent specialized for exploring codebases — cheap free model"
    },
    "general": {
      "model": "opencode/deepseek-v4-flash-free"
    },
    "sdd-init": {
      "model": "opencode/laguna-s-2.1-free"
    },
    "sdd-explore": {
      "model": "opencode/laguna-s-2.1-free"
    },
    "sdd-propose": {
      "model": "google/gemini-3.5-flash-lite"
    },
    "sdd-spec": {
      "model": "google/gemini-3.5-flash-lite"
    },
    "sdd-design": {
      "model": "google/gemini-3.5-flash-lite"
    },
    "sdd-tasks": {
      "model": "google/gemini-3.5-flash-lite"
    },
    "sdd-apply": {
      "model": "opencode/deepseek-v4-flash-free"
    },
    "sdd-verify": {
      "model": "google/gemini-3.5-flash-lite"
    },
    "sdd-archive": {
      "model": "opencode/laguna-s-2.1-free"
    },
    "sdd-onboard": {
      "model": "opencode/laguna-s-2.1-free"
    },
    "git-manager": {
      "description": "Git branch management, PR creation, sync operations, and cleanup across branches",
      "mode": "subagent",
      "permission": {
        "bash": "allow",
        "edit": "deny"
      }
    },
    "code-fixer": {
      "description": "Auto-fix ESLint, stylelint, CSS Modules/BEM issues across the codebase",
      "mode": "subagent",
      "permission": {
        "edit": "allow"
      }
    },
    "i18n-manager": {
      "description": "Manage i18n translation files (en/es), add missing keys, validate consistency",
      "mode": "subagent",
      "permission": {
        "read": "allow",
        "edit": "allow"
      }
    },
    "go-bridge-dev": {
      "description": "Go development for whatsapp-bridge-go — build, test, fix, maintain WhatsApp WebSocket bridge",
      "mode": "subagent",
      "permission": {
        "edit": "allow"
      }
    }
  }
}
