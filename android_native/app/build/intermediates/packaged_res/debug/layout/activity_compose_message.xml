<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#F8FAFC">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Nueva Conversación"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#1E293B"
        android:layout_marginBottom="20dp" />

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="16dp"
        app:cardElevation="4dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="¿A quién quieres contactar?"
                android:textSize="14sp"
                android:textColor="#64748B"
                android:layout_marginBottom="8dp" />

            <Spinner
                android:id="@+id/spinnerRecipientType"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/spinner_bg"
                android:layout_marginBottom="16dp" />

            <!-- Individual Layout -->
            <LinearLayout
                android:id="@+id/layoutIndividual"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Selecciona un miembro del staff"
                    android:textSize="14sp"
                    android:textColor="#64748B"
                    android:layout_marginBottom="8dp" />

                <Spinner
                    android:id="@+id/spinnerRecipient"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/spinner_bg"
                    android:layout_marginBottom="24dp" />

                <Button
                    android:id="@+id/btnStartChat"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="Abrir Chat"
                    android:backgroundTint="#0EA5E9"
                    android:textColor="@android:color/white"
                    app:cornerRadius="12dp" />
            </LinearLayout>

            <!-- Broadcast Layout -->
            <LinearLayout
                android:id="@+id/layoutBroadcast"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <EditText
                    android:id="@+id/etSubject"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Asunto (Opcional)"
                    android:background="@drawable/edittext_bg"
                    android:padding="12dp"
                    android:textSize="14sp"
                    android:layout_marginBottom="12dp" />

                <EditText
                    android:id="@+id/etMessage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="120dp"
                    android:gravity="top"
                    android:hint="Escribe el comunicado para todo el staff..."
                    android:background="@drawable/edittext_bg"
                    android:padding="12dp"
                    android:textSize="14sp"
                    android:layout_marginBottom="24dp" />

                <Button
                    android:id="@+id/btnSend"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="Enviar Comunicado"
                    android:backgroundTint="#0EA5E9"
                    android:textColor="@android:color/white"
                    app:cornerRadius="12dp" />
            </LinearLayout>

            <Button
                android:id="@+id/btnCancel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Cancelar"
                android:layout_marginTop="8dp"
                style="?android:attr/borderlessButtonStyle"
                android:textColor="#64748B" />

        </LinearLayout>
    </androidx.cardview.widget.CardView>
</LinearLayout>
