<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/tvDetailPatientName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Patient Name"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/tvDetailDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Date / Time"
            android:textSize="16sp"
            android:layout_marginBottom="16dp"/>

        <!-- Compliance Mini Stars -->
        <LinearLayout
            android:id="@+id/layoutComplianceStars"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="24dp"
            android:visibility="gone">
            <TextView android:id="@+id/tvDetailFStars" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/rating_gold" android:textSize="16sp" android:layout_marginEnd="8dp"/>
            <TextView android:id="@+id/tvDetailAStars" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/rating_blue" android:textSize="16sp" android:layout_marginEnd="8dp"/>
            <TextView android:id="@+id/tvDetailBStars" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/rating_pink" android:textSize="16sp"/>
        </LinearLayout>

        <!-- Doctor Section -->
        <LinearLayout
            android:id="@+id/layoutDoctorActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">
            
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/detail_notes_label"
                android:textStyle="bold"/>
                
            <EditText
                android:id="@+id/etNotes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minLines="3"
                android:gravity="top"
                android:background="#EEE"
                android:padding="8dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="16dp"/>
                
            <Button
                android:id="@+id/btnSaveNotes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/detail_save_notes"
                android:layout_marginBottom="24dp"/>

            <!-- Enhanced Doctor View Sections -->
            <TextView
                android:id="@+id/tvLastVisit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Last Visit: N/A"
                android:textSize="14sp"
                android:textColor="#777"
                android:layout_marginBottom="16dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Patient Files"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"/>
            
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvPatientFiles"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="100dp"
                android:layout_marginBottom="16dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Appointment History"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"/>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvAppointmentHistory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="100dp"
                android:layout_marginBottom="16dp"/>
        </LinearLayout>

        <!-- Secretary Section -->
        <LinearLayout
            android:id="@+id/layoutSecretaryActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">
            
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/detail_status_label"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"/>
                
            <Button
                android:id="@+id/btnMarkConfirmed"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/status_confirm"
                android:backgroundTint="#2196F3"/>
                
            <Button
                android:id="@+id/btnMarkArrived"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/status_arrived"
                android:backgroundTint="#4CAF50"/>
                
            <Button
                android:id="@+id/btnMarkCompleted"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/status_complete"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="2">
                
                <Button
                    android:id="@+id/btnMarkAbsent"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/status_absent"
                    android:layout_marginEnd="4dp"
                    android:backgroundTint="#9E9E9E"/>

                <Button
                    android:id="@+id/btnMarkCancelled"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/status_cancel"
                    android:layout_marginStart="4dp"
                    android:backgroundTint="#F44336"/>
            </LinearLayout>

            <Button
                android:id="@+id/btnMarkRescheduled"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/status_reschedule"
                android:backgroundTint="#9C27B0"
                android:layout_marginTop="8dp"/>
                
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#CCC"
                android:layout_marginVertical="16dp"/>
                
            <Button
                android:id="@+id/btnMarkPaid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/status_paid"
                android:backgroundTint="#FF9800"/>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
