<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/tvDetailPatientName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Patient Name"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:id="@+id/tvDetailDate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Date / Time"
        android:textSize="16sp"
        android:layout_marginBottom="24dp"/>

    <!-- Doctor Section -->
    <LinearLayout
        android:id="@+id/layoutDoctorActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">
        
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/detail_notes_label"
            android:textStyle="bold"/>
            
        <EditText
            android:id="@+id/etNotes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minLines="3"
            android:gravity="top"
            android:background="#EEE"
            android:padding="8dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp"/>
            
        <Button
            android:id="@+id/btnSaveNotes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/detail_save_notes"/>
    </LinearLayout>

    <!-- Secretary Section -->
    <LinearLayout
        android:id="@+id/layoutSecretaryActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">
        
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/detail_status_label"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>
            
        <Button
            android:id="@+id/btnMarkConfirmed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/status_confirm"
            android:backgroundTint="#4CAF50"/>
            
        <Button
            android:id="@+id/btnMarkCompleted"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/status_complete"/>
            
        <Button
            android:id="@+id/btnMarkAbsent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/status_absent"
            android:backgroundTint="#F44336"/>
            
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#CCC"
            android:layout_marginVertical="16dp"/>
            
        <Button
            android:id="@+id/btnMarkPaid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/status_paid"
            android:backgroundTint="#FF9800"/>
    </LinearLayout>

</LinearLayout>
