
# General Settings
PORT=5000
NODE_ENV=development
TZ=America/Argentina/Buenos_Aires

# Database Settings
DB_HOST=db
DB_USER=root
DB_PASSWORD=
DB_NAME=clinical_management
DB_PORT=3306

# Auth
# OBLIGATORIA en produccion (docker-compose.prod.yml la requiere sin default)
JWT_SECRET=

# Frontend Settings
VITE_API_URL=http://localhost:5000/api

# ==============================================================
# Produccion (docker-compose.prod.yml)
# ==============================================================
# Password root de MariaDB en el contenedor db-prod. OBLIGATORIA.
DB_ROOT_PASSWORD_PROD=
# Puerto externo del contenedor de BD en el host (default 3310)
DB_EXTERNAL_PORT_PROD=3310
# Nombre de la BD de produccion (default clinical_management)
DB_NAME_PROD=clinical_management
# Red externa de proxy (nginx-proxy-manager, default proxy-network)
PROXY_NETWORK_NAME=proxy-network

# AI Providers (WhatsApp suggestions)
# Provider priority: the `ai_provider` system setting (ai_provider = ollama|groq|gemini)
# wins when set; otherwise it is derived from env: OLLAMA_BASE_URL -> ollama,
# only GEMINI_API_KEY -> gemini, else groq (both keys -> groq). Fallback order is
# always ollama -> groq -> gemini for the remaining configured providers.
# From the Docker server container, reach the host with host.docker.internal.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2
# Gemini (used when selected as primary, or as fallback)
GEMINI_API_KEY=
# Groq (used when selected as primary, or as fallback)
GROQ_API_KEY=
