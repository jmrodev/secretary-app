{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "secretary-app",
  "compatibility_date": "2025-01-01",
  "main": "worker.js",
  "assets": {
    "directory": "client/dist",
    "binding": "ASSETS"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": {
    "enabled": true
  }
}
